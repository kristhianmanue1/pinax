   163	    elif kind == "b64u":
   164	        if not isinstance(v, str) or any(c not in B64U_ALPHABET for c in v):
   165	            return "bad_base64"
   166	    elif kind == "array_str":
   167	        if not isinstance(v, list) or len(v) > extra:
   168	            return "invalid_type"
   169	        if any(not isinstance(i, str) for i in v):
   170	            return "invalid_type"
   171	    elif kind == "map_str":
   172	        if not isinstance(v, dict) or len(v) > extra:
   173	            return "invalid_type"
   174	        if any(not isinstance(k, str) or not isinstance(i, str) for k, i in v.items()):
   175	            return "invalid_type"
   176	    elif kind == "object":
   177	        return _check_object(v, extra[0], extra[1])
   178	    elif kind == "array_obj":
   179	        if not isinstance(v, list):
   180	            return "invalid_type"
   181	        for item in v:
   182	            diag = _check_object(item, extra[0], extra[1])
   183	            if diag:
   184	                return diag
   185	    elif kind == "any":
   186	        return None
   187	    return None
