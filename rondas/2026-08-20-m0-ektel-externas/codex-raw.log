   212	# -- Criptografía byte-exacta (§5.2, §6.4, §6.5) ------------------------------
   213	
   214	def b64u_decode_strict(s: str) -> bytes:
   215	    if not B64U_RE.match(s):
   216	        raise ValueError("bad_base64")
   217	    if len(s) % 4 == 1:
   218	        raise ValueError("bad_base64")
   219	    return urlsafe_b64decode(s + "=" * ((-len(s)) % 4))
   220	
   221	
   222	def envelope_mac(key: bytes, domain: str, phb64: str, plb64: str) -> bytes:
   223	    msg = b"ektel/" + domain.encode("ascii") + b"/v1\x00" + phb64.encode() + b"." + plb64.encode()
   224	    return hmac.new(key, msg, hashlib.sha256).digest()
   225	
   226	
   227	# -- Parsers por tipo ---------------------------------------------------------
   228	
   229	def parse_signed_envelope(wire_type: str, raw: bytes, key: bytes) -> ParseResult:
   230	    env, diag = strict_json(raw)
   231	    if diag:
   232	        return reject(diag)
   233	    env_schema = load_schema("envelope.schema.json")
   234	    diag = check(env, env_schema)
   235	    if diag == "invalid_value" and isinstance(env, dict):
   236	        # '=' (padding) u otro carácter fuera del alfabeto base64url en los
   237	        # campos codificados es bad_base64, no invalid_value.
   238	        for k in ("protected_header_b64", "payload_b64", "signature"):
   239	            v = env.get(k)
   240	            if isinstance(v, str) and not B64U_RE.match(v):
   241	                return reject("bad_base64")
   242	    if diag:
   243	        return reject(diag)
   244	    phb64, plb64, sig = env["protected_header_b64"], env["payload_b64"], env["signature"]
   245	    # base64url estricto sin padding: '=' u otro carácter fuera del alfabeto
   246	    # es bad_base64, no invalid_value.
   247	    for field in (phb64, plb64, sig):
   248	        if not B64U_RE.match(field) or len(field) % 4 == 1:
   249	            return reject("bad_base64")
   250	    try:
   251	        sig_bytes = b64u_decode_strict(sig)
   252	    except ValueError:
   253	        return reject("bad_base64")
   254	    # Verificar MAC ANTES de decodificar (§5.2).
   255	    if not hmac.compare_digest(sig_bytes, envelope_mac(key, ENVELOPE_DOMAINS[wire_type], phb64, plb64)):
   256	        return reject("bad_signature")
   257	    try:
   258	        header_raw = b64u_decode_strict(phb64)
   259	        payload_raw = b64u_decode_strict(plb64)
   260	    except ValueError:
   261	        return reject("bad_base64")
   262	    header, diag = strict_json(header_raw)
   263	    if diag:
   264	        return reject(diag)
   265	    diag = check(header, load_schema("protected-header.schema.json"))
   266	    if diag == "invalid_value" and isinstance(header, dict) and header.get("alg") != "HS256":
   267	        return reject("alg_unsupported")
   268	    if diag:
   269	        return reject(diag)
   270	    if header["typ"] != HEADER_TYP[wire_type]:
   271	        return reject("invalid_value")
   272	    payload, diag = strict_json(payload_raw)
   273	    if diag:
   274	        return reject(diag)
   275	    diag = schema_version_diag(payload)
   276	    if diag:
   277	        return reject(diag)
   278	    diag = check(payload, load_schema(PAYLOAD_SCHEMA_FILES[wire_type]))
   279	    if diag:
   280	        return reject(diag)
   281	    digest = hashlib.sha256((phb64 + "." + plb64).encode("ascii")).hexdigest()
   282	    return accept(payload, digest)
   283	
   284	
   285	def parse_proof(raw: bytes, key: bytes) -> ParseResult:
   286	    value, diag = strict_json(raw)
   287	    if diag:
   288	        return reject(diag)
   289	    diag = schema_version_diag(value)
   290	    if diag:
   291	        return reject(diag)
   292	    diag = check(value, load_schema("invocation-proof.schema.json"))
   293	    if diag:
   294	        return reject(diag)
   295	    nonce = bytes.fromhex(value["nonce"])
   296	    digest_bytes = bytes.fromhex(value["payload_digest"])
   297	    mac = bytes.fromhex(value["mac"])
   298	    msg = b"ektel/pop/v1\x00" + struct.pack(">I", len(nonce)) + nonce + digest_bytes
   299	    if not hmac.compare_digest(mac, hmac.new(key, msg, hashlib.sha256).digest()):
   300	        return reject("bad_signature")
   301	    return accept(value)
   302	
   303	
   304	def parse_strict_document(wire_type: str, raw: bytes) -> ParseResult:
   305	    value, diag = strict_json(raw)
   306	    if diag:
   307	        return reject(diag)
   308	    diag = schema_version_diag(value)
   309	    if diag:
   310	        return reject(diag)
   311	    diag = check(value, load_schema(DOCUMENT_SCHEMA_FILES[wire_type]))
   312	    if diag:
   313	        return reject(diag)
   314	    return accept(value)
   315	
   316	
   317	def parse_wire(wire_type: str, raw: bytes, key: bytes) -> ParseResult:
   318	    if wire_type in ENVELOPE_DOMAINS:
   319	        return parse_signed_envelope(wire_type, raw, key)
   320	    if wire_type == "invocation-proof":
   321	        return parse_proof(raw, key)
   322	    if wire_type in DOCUMENT_SCHEMA_FILES:
   323	        return parse_strict_document(wire_type, raw)
   324	    raise ValueError(f"wire type desconocido: {wire_type}")
