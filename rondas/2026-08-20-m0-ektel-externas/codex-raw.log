   287	    "artifact_identity_profile": ("enum", ["route_mutable_unverified"]),
   288	    "started_at_wall": ("int", None), "finished_at_wall": ("int", None),
   289	    "duration_monotonic_ms": ("int", None), "exit_code_or_signal": ("str", 0),
   290	    "cause_code": ("enum", ["natural_exit", "deadline_duration", "deadline_validity_exhausted",
   291	                            "external_termination", "supervision_failure"]),
   292	    "validity_at_admission": ("object", ({"nbf": ("int", None), "exp": ("int", None)}, {"nbf", "exp"})),
   293	    "guarantees_applied": ("array_obj", GUARANTEE_ENTRY),
   294	    "measurements": ("any", None),
   295	    "stdout_truncation": ("bool", None), "stderr_truncation": ("bool", None),
   296	    "discarded_bytes": ("int", None), "last_event_receipt": ("str", 0),
   297	}, {"schema_version", "action_id", "identity_digest", "state",
   298	    "artifact_identity_profile", "guarantees_applied"})
