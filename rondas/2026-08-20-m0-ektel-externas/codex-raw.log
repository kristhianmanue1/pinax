    92	
    93	# -- JSON estricto -----------------------------------------------------------
    94	
    95	class DupKey(Exception):
    96	    pass
    97	
    98	
    99	def strict_json(raw: bytes):
   100	    if len(raw) > SIZE_LIMIT:
   101	        return None, "size_exceeded"
   102	    try:
   103	        text = raw.decode("utf-8")
   104	    except UnicodeDecodeError:
   105	        return None, "malformed_json"
   106	
   107	    def hook(pairs):
   108	        seen = {}
   109	        for k, v in pairs:
   110	            if k in seen:
   111	                raise DupKey(k)
   112	            seen[k] = v
   113	        return seen
   114	
   115	    try:
   116	        return json.loads(text, object_pairs_hook=hook,
   117	                          parse_constant=lambda c: (_ for _ in ()).throw(ValueError(c))), None
   118	    except DupKey:
   119	        return None, "duplicate_key"
   120	    except ValueError:
   121	        return None, "malformed_json"
   122	
   123	
   124	# -- Intérprete del subconjunto de JSON Schema --------------------------------
   125	
   126	def load_schema(name: str) -> dict:
   127	    return json.loads((SCHEMA_DIR / name).read_text(encoding="utf-8"))
   128	
   129	
   130	def check(value, schema: dict) -> str | None:
   131	    """Valida value contra el subconjunto usado en contracts/schemas/v1."""
   132	    if "$ref" in schema:
   133	        return check(value, load_schema(schema["$ref"]))
   134	    if "const" in schema:
   135	        if value != schema["const"] or type(value) is not type(schema["const"]):
   136	            return "invalid_value"
   137	        return None
   138	    if "enum" in schema:
   139	        for option in schema["enum"]:
   140	            if value == option and type(value) is type(option):
   141	                return None
   142	        return "invalid_value"
   143	    t = schema.get("type")
   144	    if t == "object":
   145	        if not isinstance(value, dict):
   146	            return "invalid_type"
   147	        props = schema.get("properties", {})
   148	        if schema.get("additionalProperties") is False:
   149	            for k in value:
   150	                if k not in props:
   151	                    return "unknown_field"
   152	        for k in schema.get("required", []):
   153	            if k not in value:
   154	                return "missing_field"
   155	        if "maxProperties" in schema and len(value) > schema["maxProperties"]:
   156	            return "invalid_value"
   157	        addl = schema.get("additionalProperties")
   158	        for k, v in value.items():
   159	            if k in props:
   160	                d = check(v, props[k])
   161	            elif isinstance(addl, dict):
   162	                d = check(v, addl)
   163	            else:
   164	                continue
   165	            if d:
   166	                return d
   167	        return None
   168	    if t == "array":
   169	        if not isinstance(value, list):
   170	            return "invalid_type"
   171	        if "maxItems" in schema and len(value) > schema["maxItems"]:
   172	            return "invalid_value"
   173	        item_schema = schema.get("items")
   174	        if item_schema:
   175	            for item in value:
   176	                d = check(item, item_schema)
   177	                if d:
   178	                    return d
   179	        return None
   180	    if t == "string":
   181	        if not isinstance(value, str):
   182	            return "invalid_type"
   183	        if "minLength" in schema and len(value) < schema["minLength"]:
   184	            return "invalid_value"
   185	        if "maxLength" in schema and len(value) > schema["maxLength"]:
   186	            return "invalid_value"
   187	        if "pattern" in schema and not re.search(schema["pattern"], value):
   188	            return "invalid_value"
   189	        return None
   190	    if t == "integer":
   191	        if not isinstance(value, int) or isinstance(value, bool):
   192	            return "invalid_type"
   193	        if "minimum" in schema and value < schema["minimum"]:
   194	            return "invalid_value"
   195	        if "maximum" in schema and value > schema["maximum"]:
   196	            return "invalid_value"
   197	        return None
   198	    if t == "boolean":
   199	        return None if isinstance(value, bool) else "invalid_type"
   200	    return None
   201	
   202	
   203	def schema_version_diag(value) -> str | None:
   204	    """schema_version mayor desconocida → diagnóstico propio (§5.5)."""
   205	    if isinstance(value, dict):
   206	        sv = value.get("schema_version")
   207	        if isinstance(sv, int) and not isinstance(sv, bool) and sv != 1:
   208	            return "schema_version_unsupported"
   209	    return None
