     1	#!/usr/bin/env python3
     2	"""Parser de referencia B — CLEAN-ROOM (M0, spec v1.2 §15/M0 enmienda R5).
     3	
     4	Protocolo clean-room declarado: este parser se escribió a partir de
     5	- la especificación `docs/especificacion/ektel-runtime-m0-m3-v1.md` (§5, §6,
     6	  §8.3),
     7	- los schemas `contracts/schemas/v1/*.schema.json`,
     8	- los vectores `contracts/vectors/v1/`,
     9	SIN leer el código de `contracts/parsers/reference/`. A diferencia del parser
    10	A (validación hand-coded), este interprete es table-driven: carga los schemas
    11	JSON en runtime y aplica el subconjunto de JSON Schema que usan (const, enum,
    12	pattern, type+minimum/maximum, required, additionalProperties, $ref local).
    13	
    14	Reglas normativas implementadas (texto de la spec, no del parser A):
    15	- §5.1 JSON estricto: NaN/Infinity fuera, claves duplicadas fuera, campos
    16	  desconocidos fuera, sin coerción (bool ≠ int), límite de tamaño.
    17	- §5.2 sobre fijo; base64url sin padding; verificar MAC ANTES de decodificar;
    18	  MAC = HMAC-SHA256(clave, ASCII("ektel/<dominio>/v1")||0x00||phb64||"."||plb64);
    19	  jamás re-serializar para verificar.
    20	- §5.2/§6.3: alg lista cerrada {"HS256"}; schema_version mayor → rechazo.
    21	- §6.4 PoP: HMAC sobre len32be(nonce)||nonce||digest_bytes con dominio
    22	  ektel/pop/v1.
    23	- §6.5 identity_digest = SHA256(phb64||"."||plb64) hex.
    24	
    25	Vocabulario de diagnósticos (cerrado, común M0): ok, malformed_json,
    26	duplicate_key, unknown_field, missing_field, invalid_type, invalid_value,
    27	size_exceeded, bad_base64, bad_signature, alg_unsupported,
    28	schema_version_unsupported.
    29	
    30	stdlib-only (ADR-006). API EXPERIMENTAL (spec §16).
    31	"""
    32	from __future__ import annotations
    33	
    34	import hashlib
    35	import hmac
    36	import json
    37	import re
    38	import struct
    39	from base64 import urlsafe_b64decode
    40	from dataclasses import dataclass
    41	from pathlib import Path
    42	
    43	SCHEMA_DIR = Path(__file__).resolve().parents[2] / "schemas" / "v1"
    44	SIZE_LIMIT = 65536
    45	
    46	# wire_type -> (schema file, dominio HMAC | None, es_sobre)
    47	ENVELOPE_DOMAINS = {
    48	    "capability-envelope": "capability",
    49	    "admission-token": "admission",
    50	    "termination-token": "termination",
    51	}
    52	PAYLOAD_SCHEMA_FILES = {
    53	    "capability-envelope": "capability-payload.schema.json",
    54	    "admission-token": "admission-token-payload.schema.json",
    55	    "termination-token": "termination-token-payload.schema.json",
    56	}
    57	HEADER_TYP = {
    58	    "capability-envelope": "capability",
    59	    "admission-token": "admission-token",
    60	    "termination-token": "termination-token",
    61	}
    62	DOCUMENT_SCHEMA_FILES = {
    63	    "invocation-proof": "invocation-proof.schema.json",
    64	    "action-request": "action-request.schema.json",
    65	    "admission-outcome": "admission-outcome.schema.json",
    66	    "start-outcome": "start-outcome.schema.json",
    67	    "termination-outcome": "termination-outcome.schema.json",
    68	    "execution-result": "execution-result.schema.json",
    69	}
