   143	def _check_kind(v: Any, kind: str, extra: Any) -> str | None:
   144	    if kind == "str":
   145	        if not isinstance(v, str):
   146	            return "invalid_type"
   147	        if extra and len(v) > extra:
   148	            return "invalid_value"
   149	    elif kind == "int":
   150	        if not _is_int(v):
   151	            return "invalid_type"
   152	        if extra and not (extra[0] <= v <= extra[1]):
   153	            return "invalid_value"
   154	    elif kind == "bool":
   155	        if not isinstance(v, bool):
   156	            return "invalid_type"
   157	    elif kind == "enum":
   158	        if v not in extra:
   159	            return "invalid_value"
   160	    elif kind == "hex":
   161	        if not _is_hex(v, extra):
