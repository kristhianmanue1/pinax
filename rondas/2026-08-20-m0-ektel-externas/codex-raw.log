    76	
    77	@dataclass
    78	class ParseResult:
    79	    verdict: str
    80	    diagnostic: str
    81	    identity_digest: str | None = None
    82	    value: object = None
    83	
    84	
    85	def reject(diag: str) -> ParseResult:
    86	    return ParseResult("reject", diag)
    87	
    88	
    89	def accept(value, digest=None) -> ParseResult:
    90	    return ParseResult("accept", "ok", identity_digest=digest, value=value)
