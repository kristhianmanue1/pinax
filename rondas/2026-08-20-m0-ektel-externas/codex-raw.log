   300	DOCUMENT_SPECS = {
   301	    "action-request": ACTION_REQUEST,
   302	    "admission-outcome": ADMISSION_OUTCOME,
   303	    "start-outcome": START_OUTCOME,
   304	    "termination-outcome": TERMINATION_OUTCOME,
   305	    "execution-result": EXECUTION_RESULT,
   306	    "invocation-proof": INVOCATION_PROOF,
