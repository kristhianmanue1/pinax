   310	# ---------------------------------------------------------------------------
   311	# Primitivas criptográficas (perfil byte-exacto v1, C2)
   312	# ---------------------------------------------------------------------------
   313	
   314	def _b64u_decode(s: str) -> bytes:
   315	    if any(c not in B64U_ALPHABET for c in s):
   316	        raise ValueError("bad_base64")
   317	    pad = (-len(s)) % 4
   318	    return urlsafe_b64decode(s + "=" * pad)
   319	
   320	
   321	def _mac_envelope(key: bytes, typ: str, phb64: str, plb64: str) -> bytes:
   322	    msg = DOMAINS[typ] + phb64.encode("ascii") + b"." + plb64.encode("ascii")
   323	    return hmac.new(key, msg, hashlib.sha256).digest()
   324	
   325	
   326	def identity_digest(phb64: str, plb64: str) -> str:
   327	    return hashlib.sha256((phb64 + "." + plb64).encode("ascii")).hexdigest()
   328	
   329	
   330	# ---------------------------------------------------------------------------
   331	# Parsers por wire type
   332	# ---------------------------------------------------------------------------
   333	
   334	ENVELOPE_SPEC = ({
   335	    "protected_header_b64": ("b64u", 0), "payload_b64": ("b64u", 0), "signature": ("b64u", 0),
   336	}, {"protected_header_b64", "payload_b64", "signature"})
   337	
   338	
   339	def parse_envelope(typ: str, raw: bytes, key: bytes) -> ParseResult:
   340	    value, diag = _strict_loads(raw)
   341	    if diag:
   342	        return _reject(diag)
   343	    diag = _check_object(value, *ENVELOPE_SPEC)
   344	    if diag:
   345	        return _reject(diag)
   346	    phb64, plb64, sig = value["protected_header_b64"], value["payload_b64"], value["signature"]
   347	    # Padding explícito: la cadena no debe decodificar a longitud con '='.
   348	    for field in (phb64, plb64, sig):
   349	        if len(field) % 4 == 1:
   350	            return _reject("bad_base64")
   351	    # Orden obligatorio: verificar MAC ANTES de decodificar (§5.2).
   352	    try:
   353	        sig_bytes = _b64u_decode(sig)
   354	    except ValueError:
   355	        return _reject("bad_base64")
   356	    if len(sig_bytes) != 32:
   357	        return _reject("bad_signature")
   358	    expected = _mac_envelope(key, typ, phb64, plb64)
   359	    if not hmac.compare_digest(sig_bytes, expected):
   360	        return _reject("bad_signature")
   361	    # Ahora sí, decodificar.
   362	    try:
   363	        header_raw = _b64u_decode(phb64)
   364	        payload_raw = _b64u_decode(plb64)
   365	    except ValueError:
   366	        return _reject("bad_base64")
   367	    header, diag = _strict_loads(header_raw)
   368	    if diag:
   369	        return _reject(diag)
   370	    if not isinstance(header, dict):
   371	        return _reject("invalid_type")
   372	    if set(header) != {"alg", "schema_version", "typ"}:
   373	        return _reject("unknown_field" if set(header) > {"alg", "schema_version", "typ"} else "missing_field")
   374	    if header["alg"] != "HS256":
   375	        return _reject("alg_unsupported")
   376	    if header["schema_version"] != 1 or not _is_int(header["schema_version"]):
   377	        return _reject("schema_version_unsupported")
   378	    if header["typ"] != typ:
   379	        return _reject("invalid_value")
   380	    payload, diag = _strict_loads(payload_raw)
   381	    if diag:
   382	        return _reject(diag)
   383	    spec, required = PAYLOAD_SPECS[typ]
   384	    diag = _check_object(payload, spec, required)
   385	    if diag == "invalid_value" and isinstance(payload, dict) and payload.get("schema_version") not in (None, 1):
   386	        return _reject("schema_version_unsupported")
   387	    if diag:
   388	        return _reject(diag)
   389	    return _accept(payload, identity_digest=identity_digest(phb64, plb64))
   390	
   391	
   392	def parse_invocation_proof(raw: bytes, key: bytes) -> ParseResult:
   393	    value, diag = _strict_loads(raw)
   394	    if diag:
   395	        return _reject(diag)
   396	    diag = _check_object(value, *INVOCATION_PROOF)
   397	    if diag:
   398	        return _reject(diag)
   399	    nonce = bytes.fromhex(value["nonce"])
   400	    digest_bytes = bytes.fromhex(value["payload_digest"])
   401	    mac = bytes.fromhex(value["mac"])
   402	    msg = POP_DOMAIN + struct.pack(">I", len(nonce)) + nonce + digest_bytes
   403	    expected = hmac.new(key, msg, hashlib.sha256).digest()
   404	    if not hmac.compare_digest(mac, expected):
   405	        return _reject("bad_signature")
   406	    return _accept(value)
   407	
   408	
   409	def parse_document(wire_type: str, raw: bytes) -> ParseResult:
   410	    value, diag = _strict_loads(raw)
   411	    if diag:
   412	        return _reject(diag)
   413	    spec, required = DOCUMENT_SPECS[wire_type]
   414	    diag = _check_object(value, spec, required)
   415	    if diag == "invalid_value" and isinstance(value, dict):
   416	        sv = value.get("schema_version")
   417	        if sv is not None and sv != 1:
   418	            return _reject("schema_version_unsupported")
   419	    if diag:
   420	        return _reject(diag)
   421	    return _accept(value)
   422	
   423	
   424	def parse_wire(wire_type: str, raw: bytes, key: bytes) -> ParseResult:
   425	    if wire_type in ENVELOPE_TYPES:
   426	        return parse_envelope(ENVELOPE_TYPES[wire_type], raw, key)
   427	    if wire_type == "invocation-proof":
   428	        return parse_invocation_proof(raw, key)
   429	    if wire_type in DOCUMENT_SPECS:
   430	        return parse_document(wire_type, raw)
   431	    raise ValueError(f"wire type desconocido: {wire_type}")
   432	
   433	
   434	ENVELOPE_TYPES = {
   435	    "capability-envelope": "capability",
   436	    "admission-token": "admission-token",
   437	    "termination-token": "termination-token",
   438	}
   439	
   440	WIRE_TYPES = sorted(list(ENVELOPE_TYPES) + ["invocation-proof"] + list(DOCUMENT_SPECS))
   441	
   442	
   443	if __name__ == "__main__":
   444	    import sys
   445	    from base64 import b64decode
   446	
   447	    wire_type, vector_file = sys.argv[1], sys.argv[2]
   448	    doc = json.loads(open(vector_file, encoding="utf-8").read())
   449	    test_key = bytes.fromhex(doc.get("test_key_hex", ""))
   450	    raw = b64decode(doc["bytes"])
   451	    r = parse_wire(wire_type, raw, test_key)
   452	    print(json.dumps({"verdict": r.verdict, "diagnostic": r.diagnostic, "identity_digest": r.identity_digest}))
