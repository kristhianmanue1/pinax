   120	def _check_object(value: Any, spec: dict[str, tuple[str, Any]], required: set[str]) -> str | None:
   121	    """spec: campo -> ("kind", extra). Devuelve diagnóstico o None.
   122	
   123	    kinds: str, int, bool, enum, hex(n), b64u, object(sub), array_str,
   124	    array_obj(sub), map_str, map_int, any
   125	    """
   126	    if not isinstance(value, dict):
   127	        return "invalid_type"
   128	    for key in value:
   129	        if key not in spec:
   130	            return "unknown_field"
   131	    for key in required:
   132	        if key not in value:
   133	            return "missing_field"
   134	    for key, (kind, extra) in spec.items():
   135	        if key not in value:
   136	            continue
   137	        diag = _check_kind(value[key], kind, extra)
   138	        if diag:
   139	            return diag
   140	    return None
